/* VeloCity — Corrected Reference Context Map (proposal, 2026-11-05)
 * Review of src/main/cml/VeloCity-Context-Map.cml against the trainer's context mapping rules.
 * Changes vs. the original:
 *  - Broke the cycle Accounts -> Rentals -> Settlement -> Accounts: Accounts now offers a generic
 *    block / lift block (with a reason) OHS; Settlement calls it (Accounts upstream).
 *  - Every downstream states ACL or CF. ACL is the default; CF is kept only towards Payments (justified below).
 *  - City -> Pricing: ACL instead of CF (the City's zone map is not an established standard).
 *  - All VeloCity teams are in one company, so every internal relationship is conceptually Customer/Supplier.
 *    Context Mapper rejects OHS and CF inside Customer/Supplier ("not applicable"), so only the relationships
 *    without OHS/CF are drawn as [S]->[C]; the others are plain U/D with this note standing for C/S.
 *    (Context Mapper warns that an ACL is "not necessarily needed" in C/S - intentional, ACL is our default.)
 *  - Unconfirmed relationships marked in comments, not in the relationship name.
 *  - Added the unconfirmed default DebtRecovery -> CustomerSupport relationship (disputes pause recovery, process 3).
 * Bounded context definitions are unchanged.
 */
ContextMap VeloCityContextMap {
	type = SYSTEM_LANDSCAPE
	state = TO_BE

	contains Accounts
	contains Rentals
	contains Pricing
	contains Settlement
	contains Payments
	contains DebtRecovery
	contains CustomerSupport
	contains FleetMaintenance
	contains PaymentProcessor
	contains City

	/* External parties */

	// verify payment method (pre-authorization), charge, payment method no longer usable
	PaymentProcessor [U]->[D,ACL] Payments : PaymentProcessing

	// zone map: stations, drop zones (everything else is an unauthorized zone)
	// ACL: the City's model is not a well-established standard and we cannot influence it
	City [U]->[D,ACL] Pricing : ZoneMap

	/* Payments
	 * Payments' teams are internal, so conceptually these are Customer/Supplier relationships.
	 * Context Mapper cannot express Customer/Supplier together with Conformist, hence plain U/D.
	 * CF justification: Payments' published language (payment method verified / invalidated,
	 * charge succeeded / failed) mirrors the standard payment-provider domain - a well-established language.
	 */

	// verify payment method (onboarding); Payment Method Invalidated -> Accounts blocks (reason: invalid card)
	// Accounts reacts to Payments' event and applies its own block internally; Payments does NOT call
	// Accounts' block OHS, as that would create a Payments <-> Accounts pair cycle.
	Payments [U,OHS,PL]->[D,CF] Accounts : PaymentMethodVerification

	// charge a finished ride (Settlement retries a few times)
	Payments [U,OHS,PL]->[D,CF] Settlement : Charging

	/* Accounts (internal, conceptually Customer/Supplier - plain U/D because of OHS) */

	// is account active?
	Accounts [U,OHS]->[D,ACL] Rentals : AccountStatus

	// block account / lift block (reason: outstanding debt); Settlement is the only source of the debt block and its lifting
	Accounts [U,OHS,PL]->[D,ACL] Settlement : AccountBlocking

	/* Rentals */

	// Rental Session Ended (start, end, location, reason)
	Rentals [S,PL]->[C,ACL] Settlement : RentalSessionEnded

	// fault detected, lock failed; withdraw / make available; reserve / unlock
	Rentals [U,OHS,PL]->[D,ACL] FleetMaintenance : BikeAvailability

	/* Pricing */

	// price for session (tariff valid at session start)
	Pricing [U,OHS]->[D,ACL] Settlement : PriceCalculation

	/* Settlement */

	// Rental Fee Unpaid -> start recovery; attempt collection
	Settlement [U,OHS,PL]->[D,ACL] DebtRecovery : DebtCollection

	/* Debt Recovery */

	// pause / resume recovery (billing dispute under review)
	// Default assumption, NOT confirmed with the domain expert.
	DebtRecovery [U,OHS,PL]->[D,ACL] CustomerSupport : RecoveryPause

	/* Customer Support */

	// fleet-issue incident -> bike broken (Fleet Maintenance then withdraws it in Rentals)
	// Default assumption, NOT confirmed with the domain expert.
	CustomerSupport [S,PL]->[C,ACL] FleetMaintenance : FleetIssueIncident
}

/* Bounded Contexts */

BoundedContext Accounts {
	type = FEATURE
	domainVisionStatement = "Onboarding, account activation, account blocks and unblocks. Key language: user, registration, activated, blocked."
	responsibilities = "Onboarding", "Account activation", "Account blocks and unblocks"
}

BoundedContext Rentals {
	type = FEATURE
	domainVisionStatement = "Bike availability (available / withdrawn), reserve & unlock for any authorised client, rental sessions, station returns & locking, max-rental-time end, withdrawing a bike on a fault it detects. Key language: reservation, unlock, rental session, available, withdrawn."
	responsibilities = "Bike availability", "Reserve and unlock", "Rental sessions", "Station returns and locking", "Max rental time end", "Withdrawing faulty bikes"
}

BoundedContext Pricing {
	type = FEATURE
	domainVisionStatement = "Pure calculation of the total fee: tiered hourly fees, penalty, drop zone / unauthorized zone fees, tariff valid at session start. Key language: free period, hourly fee, penalty, drop zone fee, total fee."
	responsibilities = "Total fee calculation", "Tariffs"
}

BoundedContext Settlement {
	type = FEATURE
	domainVisionStatement = "Charging each finished ride, retries, rider's balance and outstanding debt. The only context that moves money. Key language: charge, settled, outstanding debt."
	responsibilities = "Charging finished rides", "Charge retries", "Rider balance", "Outstanding debt"
}

BoundedContext Payments {
	type = FEATURE
	domainVisionStatement = "Payment method verification and charging; shields VeloCity from the external processor. Key language: payment method, pre-authorization, verified, charge."
	responsibilities = "Payment method verification", "Charging"
}

BoundedContext DebtRecovery {
	type = FEATURE
	domainVisionStatement = "Active pursuit of outstanding debt: reminders, payment plans, pause / resume. Key language: recovery process, paused, resumed, exhausted, payment plan."
	responsibilities = "Reminders", "Payment plans", "Pausing and resuming recovery"
}

BoundedContext CustomerSupport {
	type = FEATURE
	domainVisionStatement = "Incidents: reported, type detected, assigned, accepted / rejected, resolved. Key language: incident, accept, reject, escalate, reopen, resolve."
	responsibilities = "Incident handling"
}

BoundedContext FleetMaintenance {
	type = FEATURE
	domainVisionStatement = "Broken bikes, maintenance, deciding when a bike returns to circulation. Key language: broken, maintenance, fixed, back in circulation."
	responsibilities = "Broken bikes", "Maintenance", "Returning bikes to circulation"
}

/* External parties */

BoundedContext PaymentProcessor {
	type = SYSTEM
	domainVisionStatement = "External payment processor."
}

BoundedContext City {
	type = SYSTEM
	domainVisionStatement = "External party providing the zone map used by Pricing."
}