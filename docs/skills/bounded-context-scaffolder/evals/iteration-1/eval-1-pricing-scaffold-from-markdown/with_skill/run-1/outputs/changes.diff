diff --git a/src/main/java/pl/wojtyna/dddtrainingv3/velocity/pricing/domain/pricelist/BillingPeriod.java b/src/main/java/pl/wojtyna/dddtrainingv3/velocity/pricing/domain/pricelist/BillingPeriod.java
