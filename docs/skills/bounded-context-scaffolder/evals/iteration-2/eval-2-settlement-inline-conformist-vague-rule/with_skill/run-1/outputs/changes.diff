+++ b/src/main/java/pl/wojtyna/dddtrainingv3/velocity/settlement/package-info.java
@@ -0,0 +1,33 @@
+/// # Settlement bounded context
+///
+/// ## Purpose
+/// Once a ride is priced, we charge the rider through their payment method, so that every ride eventually gets paid.
+///
+/// ## Ubiquitous language
+/// - **Settlement**: the process of collecting money for one priced ride.
+/// - **Charge Attempt**: one try to take money from the rider's payment method.
+/// - **Outstanding Debt**: the unpaid amount left after all attempts fail.
+///
+/// ## Business decisions
+/// - **Record debt after the 3rd failed charge attempt**: given a priced ride of 12.50 PLN with 2 failed charge
+///   attempts, when the 3rd charge attempt fails, then an Outstanding Debt of 12.50 PLN is recorded and Debt Recorded
+///   is published. Enforced by `Settlement`, see `SettlementTest#thirdFailedChargeAttemptRecordsOutstandingDebt`.
+/// - **A successful retry settles the ride**: given a priced ride of 12.50 PLN with 1 failed charge attempt, when the
+///   2nd charge attempt succeeds, then the ride is settled and no Outstanding Debt is recorded. Enforced by
+///   `Settlement`, see `SettlementTest#successfulSecondChargeAttemptSettlesRide`.
+/// - **When retries are made** (*not modelled yet*): "we retry a few times shortly after the ride". The timing of the
+///   2nd and 3rd Charge Attempt is awaiting a strict Given/When/Then example, see the plan.
+///
+/// ## Open questions
+/// - How does Settlement learn the outcome of a Charge Attempt: a synchronous result of Charge Rider, or events from
+///   Payments? (plan, Q5)
+/// - What happens to a Charge Attempt outcome reported after the ride is settled or the debt is recorded? (plan, Q6)
+/// - Does a ride priced at 0 create a Settlement and a charge at all? (plan, Q4)
+///
+/// Source canvas: `docs/bounded-contexts/velocity/settlement/canvas.md`
+@BoundedContext(name = "Settlement")
+@Module
+package pl.wojtyna.dddtrainingv3.velocity.settlement;
+
+import org.jmolecules.ddd.annotation.BoundedContext;
+import org.jmolecules.ddd.annotation.Module;
diff --git a/src/test/java/pl/wojtyna/dddtrainingv3/velocity/settlement/domain/settlement/SettlementTest.java b/src/test/java/pl/wojtyna/dddtrainingv3/velocity/settlement/domain/settlement/SettlementTest.java
new file mode 100644
index 0000000..e0a2f7a
--- /dev/null
+++ b/src/test/java/pl/wojtyna/dddtrainingv3/velocity/settlement/domain/settlement/SettlementTest.java
@@ -0,0 +1,70 @@
+package pl.wojtyna.dddtrainingv3.velocity.settlement.domain.settlement;
+
+import pl.wojtyna.dddtrainingv3.velocity.settlement.domain.charging.RideId;
+import pl.wojtyna.dddtrainingv3.velocity.settlement.domain.charging.RiderId;
+import org.joda.money.CurrencyUnit;
+import org.joda.money.Money;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@DisplayName("Settlement examples")
+class SettlementTest {
+
+    private static final Money PRICE_12_50_PLN = Money.of(CurrencyUnit.of("PLN"), new BigDecimal("12.50"));
+
+    // @formatter:off
+    @DisplayName(
+        """
+         given a priced ride of 12.50 PLN with 2 failed charge attempts,
+         when the 3rd charge attempt fails,
+         then an Outstanding Debt of 12.50 PLN is recorded and Debt Recorded is published
+        """
+    )
+    // @formatter:on
+    @Test
+    void thirdFailedChargeAttemptRecordsOutstandingDebt() {
+        // given
+        var settlement = Settlement.forPricedRide(new RideId("R-1"), new RiderId("A"), PRICE_12_50_PLN);
+        settlement.chargeAttemptFailed();
+        settlement.chargeAttemptFailed();
+
+        // when
+        var events = settlement.chargeAttemptFailed();
+
+        // then
+        assertThat(events.hasAtLeastOneEventMatching(
+            event -> event instanceof SettlementEvent.DebtRecorded debtRecorded
+                     && debtRecorded.rideId().equals(new RideId("R-1"))
+                     && debtRecorded.riderId().equals(new RiderId("A"))
+                     && debtRecorded.outstandingDebt().equals(new OutstandingDebt(PRICE_12_50_PLN)))).isTrue();
+    }
+
+    // @formatter:off
+    @DisplayName(
+        """
+         given a priced ride of 12.50 PLN with 1 failed charge attempt,
+         when the 2nd charge attempt succeeds,
+         then the ride is settled and no Outstanding Debt is recorded
+        """
+    )
+    // @formatter:on
+    @Test
+    void successfulSecondChargeAttemptSettlesRide() {
+        // given
+        var settlement = Settlement.forPricedRide(new RideId("R-1"), new RiderId("A"), PRICE_12_50_PLN);
+        settlement.chargeAttemptFailed();
+
+        // when
+        var events = settlement.chargeAttemptSucceeded();
+
+        // then
+        assertThat(events.hasAtLeastOneEventMatching(
+            event -> event instanceof SettlementEvent.RideSettled settled
+                     && settled.rideId().equals(new RideId("R-1")))).isTrue();
+        assertThat(events.hasOccurredEventOfType(SettlementEvent.DebtRecorded.class)).isFalse();
+    }
+}
