+import org.joda.money.CurrencyUnit;
+import org.joda.money.Money;
+
+import java.util.Objects;
+
+/// **Return Charges**: drop-zone or unauthorized-zone charges reported by Rentals.
+@ValueObject
+public record ReturnCharges(Money amount) {
+
