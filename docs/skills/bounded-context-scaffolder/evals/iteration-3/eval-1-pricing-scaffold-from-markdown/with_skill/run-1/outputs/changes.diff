diff --git a/src/main/java/pl/wojtyna/dddtrainingv3/velocity/pricing/domain/pricelists/BillingPeriod.java b/src/main/java/pl/wojtyna/dddtrainingv3/velocity/pricing/domain/pricelists/BillingPeriod.java
